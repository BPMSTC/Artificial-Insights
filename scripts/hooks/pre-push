#!/bin/sh
ROOT="$(git rev-parse --show-toplevel)"
if command -v python3 >/dev/null 2>&1; then
  exec python3 "$ROOT/scripts/pre_push_check.py"
elif command -v python >/dev/null 2>&1; then
  exec python "$ROOT/scripts/pre_push_check.py"
elif command -v py >/dev/null 2>&1; then
  exec py -3 "$ROOT/scripts/pre_push_check.py"
fi
echo "pre-push: python not found; skipping gh-pages check." >&2
exit 0
